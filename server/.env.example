PORT=3001

# 로그인 토큰 서명용 비밀키 (반드시 설정. 미설정 시 서버가 시작되지 않음)
# 생성 예: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# 토스플레이스 웹훅 시크릿 (나중에 설정)
TOSS_WEBHOOK_SECRET=your_webhook_secret

# 자격증명 암호화 키 (server/src/crypto.js 참고). 설정하면 stores.webhook_secret,
# stores.toss_client_secret, store_integrations.credentials 안의 client_secret이
# AES-256-GCM으로 암호화되어 DB에 저장된다. 서버 기동마다 자기 치유 백필(credentialsBackfill.js)이
# 돌아서 아직 평문인 자격증명을 자동으로 암호화하므로, 나중에 이 값을 추가해도 재배포하면 적용된다.
# 미설정 시에는 지금까지처럼 전부 평문으로 저장/조회된다(DB 덤프 유출 시 그대로 노출).
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 경고: 한 번 설정한 키를 분실하거나 다른 값으로 바꾸면 이미 암호화된 자격증명을 절대 복구할 수
# 없다(GCM 인증 태그 검증 실패). webhook_secret이 여기 포함되므로, 키를 잃으면 해당 가맹점의
# 웹훅 서명 검증이 전부 실패해 매출 유입이 끊긴다 — 키는 반드시 안전한 곳에 별도 백업해둘 것.
CREDENTIALS_KEY=

# 토스페이먼츠 결제 연동 (발주 대금 결제) — 시크릿 키는 절대 외부 노출 금지
# https://developers.tosspayments.com 에서 상점 등록 후 발급
TOSS_SECRET_KEY=test_sk_...

# 토스플레이스 매출 동기화용 키 (위 토스페이먼츠 키와는 별개 — docs.tossplace.com 발급)
# 매장이 배달앱 연동을 켜둔 경우 배민/쿠팡이츠/요기요 주문도 이 동기화 하나로 함께 들어온다
# (주문의 channel 값으로 구분됨, server/src/channels/toss.js 참고) — 별도 키 불필요
TOSS_PLACE_ACCESS_KEY=
TOSS_PLACE_SECRET_KEY=

# 최초 슈퍼 관리자 계정 (server/src/db/schema.js의 initDb() 참고).
# users 테이블에 SUPER_ADMIN이 단 한 명도 없을 때, 서버 최초 기동 시에만 부트스트랩용으로 생성된다
# (이미 계정이 있으면 이 값들은 무시되고 기존 비밀번호는 절대 바뀌지 않는다).
# INITIAL_ADMIN_EMAIL 미설정 시 코드 기본값(server/src/db/schema.js 참고)으로 생성된다.
# INITIAL_ADMIN_PASSWORD 미설정 시: 로컬 개발(DATABASE_URL 없음)은 코드에 정의된 로컬 기본 비밀번호로 생성되고,
# 운영(DATABASE_URL 있음)은 임의의 안전한 비밀번호를 생성해 서버 로그에 한 번 출력한다 —
# 배포 로그에서 확인해 로그인한 뒤 반드시 즉시 비밀번호를 변경할 것.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# 운영 환경 CORS 허용 출처 (server/src/index.js 참고). 프론트엔드가 배포된 실제 주소를 넣는다.
# 쉼표로 구분해 여러 출처를 등록할 수 있다 (예: https://a.example.com,https://b.example.com).
# 스킴(https://)은 생략해도 자동으로 붙고 끝 슬래시도 자동 제거되므로 호스트명만 넣어도 된다
# (render.yaml에는 호스트명만 넣기 쉬워서 넣은 보정 로직).
# 운영(DATABASE_URL이 설정된 환경)에서 이 값을 비워두면 프론트엔드 요청이 전부 CORS로 차단되고,
# 서버 로그에 경고가 남는다.
# 로컬 개발에서는 localhost와 Cloudflare Quick Tunnel(*.trycloudflare.com), *.onrender.com 출처가
# 자동으로 허용되므로 보통 비워둬도 된다.
CLIENT_URL=

# Postgres SSL (운영에서만 의미 있음 — DATABASE_URL이 있을 때).
# 기본값은 SSL 사용. Render 등 관리형 Postgres는 자체 서명 인증서를 쓰므로 검증은 하지 않는다.
# SSL을 켜지 않은 Postgres(로컬 docker, 자체 호스팅)에 붙어야 하면 disable로 끈다 —
# 끄지 않으면 "The server does not support SSL connections"로 연결 자체가 실패한다.
DATABASE_SSL=
